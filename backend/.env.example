# Copy to application-local.yml or export as env vars. Never commit real secrets.

# Spring profile: dev | demo | prod
SPRING_PROFILES_ACTIVE=dev

# MongoDB (a server is expected on localhost:27017 in dev/demo; use Atlas mongodb+srv:// in prod)
MONGODB_URI=mongodb://localhost:27017/gymkhata_dev

# Server & Reverse Proxy
SERVER_PORT=8080
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# CORS allowed origins (comma-separated; required in prod, must NOT be * or localhost in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# JWT signing secret (REQUIRED in prod: >= 32 bytes random secret; fails fast if missing or default)
JWT_SECRET=gymkhata-dev-secret-change-me-0123456789abcdef0123456789abcdef

# Seed super admin (created on first boot if missing; fails fast in prod if left at ChangeMe@123)
SUPER_ADMIN_PHONE=+919000000001
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=Platform Admin

# Rate limiting (IP sliding window, X-Forwarded-For aware)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# Signup
SIGNUP_AUTO_ACTIVATE=false

# Messaging: clicktochat (default, production-ready) | whatsappcloud (coming soon / requires sandbox verification) | mock
MESSAGING_PROVIDER=clicktochat
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE_RENEWAL_EN=gymkhata_renewal_en
WHATSAPP_CLOUD_TEMPLATE_RENEWAL_HI=gymkhata_renewal_hi

# Payments: directupi (default, zero-MDR UPI QR + UTR) | razorpay (coming soon / requires sandbox verification) | mock
PAYMENT_PROVIDER=directupi
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
